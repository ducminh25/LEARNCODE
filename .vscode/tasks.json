{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C++: g++.exe build active file",
            "command": "C:\\Themis\\GCC\\bin\\g++.exe",
            "args": [
                "-std=c++14",
                "-pipe",
                "-O2",
                "-s",
                "-static",
                "-lm",
                "-x",
                "c++",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:\\Themis\\GCC\\bin"
            },
            "group": "build"
        },
        {
            "type": "shell",
            "label": "C: gcc.exe build active file",
            "command": "C:\\Themis\\GCC\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}